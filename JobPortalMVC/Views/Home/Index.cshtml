<div class="d-flex justify-content-center mt-5">
    <div class="p-4 rounded" style="min-width: 500px;">
        <h5 class="mb-4 text-center text-warning">Welcome To Job Portal</h5>
        <div class="d-flex flex-column gap-6">
            @Html.ActionLink("Register As Jobseeker", "Register_Jobseeker_Load", "Register_JobSeeker", null, new { @class = "btn btn-primary mb-2" })
            @Html.ActionLink("Register As Employer", "Register_Load", "Register_Employer", null, new { @class = "btn btn-secondary mb-2" })
            @Html.ActionLink("Login", "Page_Load", "Login", null, new { @class = "btn btn-success" })
        </div>
    </div>
</div>
