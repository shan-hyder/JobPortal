@model JobPortalMVC.Models.JobseekerHome
@{
    ViewBag.Title = "JobseekerHome_Load";
}

<div>
    <h1 class="text-center text-danger">Welcome @ViewBag.name</h1>
</div>
<div>
    <h1 class="text-center text-warning" style="border-bottom-color:black">Application Status</h1>
</div>


@using (Html.BeginForm("JobseekerHome_Load", "JobSeekrHome", FormMethod.Get))

{
    <div class="jumbotron">
        <table class="table">

            <thead>
                <tr>
                    <td>
                        Employername
                    </td>
                    <td>
                        Jobname
                    </td>
                    <td>
                        Status
                    </td>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.appliedjobs)
                {
                    <tr>
                        <td>
                            @i.employername
                        </td>
                        <td>
                            @i.jobname
                        </td>
                        <td>
                            @i.status
                        </td>
                    </tr>
                }

            </tbody>


        </table>

    </div>

}



@using (Html.BeginForm("SearchJob", "JobSeekrHome", FormMethod.Post))
{
<div class="row mb-4">
    <div class="col-md-6">
        <label for="SearchTerm" class="form-label text-danger">Search jobs</label>
        <div class="input-group">
            <input type="text" name="SearchTerm" class="form-control" id="SearchTerm" placeholder="eg:Software" />
            <div class="input-group-append">
                <button type="submit" class="btn btn-success">Search</button>
            </div>
        </div>
    </div>
</div>
}

<h2 class="text-center text-danger">Job Postes By Companies</h2>
<div class="jumbotron d-flex justify-content-center">
    <div>
        @Html.DisplayFor(m => m.message);
        <table class="table-bordered">
            <thead>
                <tr>
                    <td>
                        Job Name
                    </td>
                    <td>
                        Req Qualification
                    </td>
                    <td>
                        Req Experience
                    </td>
                    <td>
                        Salary
                    </td>
                    <td>
                        Employer Name
                    </td>
                    <td>
                        Post Date
                    </td>
                    <td>
                        Valid Until
                    </td>
                    <td>
                        Apply
                    </td>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.alljobs)
                {
                    <tr>
                        <td>
                            @i.name
                        </td>
                        <td>@i.qualification</td>
                        <td>@i.experience</td>
                        <td>
                            @i.salary
                        </td>
                        <td>
                            @i.employername
                        </td>
                        <td>
                            @i.postdate
                        </td>
                        <td>
                            @i.validuntil
                        </td>
                        <td>
                            <button type="button" data-toggle="modal" data-target="#applyModal_@i.id" class="btn btn-primary btn-sm">Apply</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @foreach (var i in Model.alljobs)
    {
        <div class="modal fade" id="applyModal_@i.id" tabindex="-1" role="dialog" aria-labelledby="applyModalLabel_@i.id" aria-hidden="true">
            <div class="modal-dialog" role="document">
                @using (Html.BeginForm("Job_Apply", "JobSeekrHome", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="applyModalLabel_@i.id">Apply to @i.name</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Employerid" value="@i.employerid" />
                            <input type="hidden" name="JobID" value="@i.id" />
                            <input type="hidden" name="Jobname" value="@i.name" />
                            <input type="hidden" name="Employername" value="@i.employername" />

                            <div class="form-group">
                                <label for="Resume">Upload Resume</label>
                                <input type="file" name="Resume" class="form-control" required />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Submit Application</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

