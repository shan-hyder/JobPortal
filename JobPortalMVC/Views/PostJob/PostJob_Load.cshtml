@model JobPortalMVC.Models.PostJobModel
@{
    ViewBag.Title = "PostJob_Load";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-center text-danger">Post New Job</h1>
<div class="jumbotron d-flex justify-content-center align-items-center">
    @using (Html.BeginForm("PostJob_Click", "PostJob", FormMethod.Post))
    {
        <div class="form-group">
            <label>
                Name :
            </label><br />
            @Html.TextBoxFor(m => m.name)
            @Html.ValidationMessageFor(m => m.name)
        </div>
        <div class="form-group">
            <label>
                Required Experience :
            </label><br />
            @Html.TextBoxFor(m => m.experience)
            @Html.ValidationMessageFor(m => m.experience)
        </div>
        <div class="form-group">
            <label>
                Salary :
            </label><br />
            @Html.TextBoxFor(m => m.salary)
            @Html.ValidationMessageFor(m => m.salary)
        </div>

        <div class="form-group">
            <label>
                Required Qualification :
            </label><br />
            @for (int i = 0; i < Model.selecetedqual.Count; i++)
            {
                var value = Model.selecetedqual[i].Svalue;
                var text = Model.selecetedqual[i].Stext;
                bool isChecked = Model.qualification != null && Model.qualification.Contains(value);

                <label class="mr-3">
                    <input type="checkbox"
                           name="qualification"
                           value="@value"
                           @(isChecked ? "checked" : "") />
                    @text
                </label>
            }

        </div>
        <div class="form-group">
            <input type="submit" class="btn btn-warning" value="Post" />
            @Html.DisplayFor(m => m.message)
        </div>
    }

</div>


